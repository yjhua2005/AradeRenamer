// ------------------------ 更改文件日期 ------------------------
// 见 更改文件日期对话框.png：两个单选决定用当前时间还是三个自定义时间，右侧是
// 确定/取消。和 设置 一样，这里的坐标只是占位，ChgDateProc 会按 DPI 重新摆放。
// 2801 带 WS_GROUP，两个单选才互斥；DTS_TIMEFORMAT(0x9) 自带 DTS_UPDOWN 位，
// 显示成那种带上下箭头的 23:46:29（再或一个 0x1 会多出勾选框）。
IDD_CHGDATE DIALOGEX 0, 0, 272, 210
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "更改文件日期"
FONT 9, "Microsoft YaHei", 0, 0, 1
BEGIN
  CONTROL         "使用当前的日期和时间", 2801, "Button", 0x54020009, 10, 8, 120, 10
  CONTROL         "使用自定义日期和时间", 2802, "Button", 0x54010009, 10, 24, 120, 10
  GROUPBOX        "创建日期", 2803, 10, 42, 252, 46
  CONTROL         "", 2806, "SysDateTimePick32", 0x50010004, 16, 56, 120, 16
  CONTROL         "", 2807, "SysDateTimePick32", 0x50010009, 160, 56, 96, 16
  GROUPBOX        "访问日期", 2804, 10, 92, 252, 46
  CONTROL         "", 2808, "SysDateTimePick32", 0x50010004, 16, 106, 120, 16
  CONTROL         "", 2809, "SysDateTimePick32", 0x50010009, 160, 106, 96, 16
  GROUPBOX        "修改日期", 2805, 10, 142, 252, 46
  CONTROL         "", 2810, "SysDateTimePick32", 0x50010004, 16, 156, 120, 16
  CONTROL         "", 2811, "SysDateTimePick32", 0x50010009, 160, 156, 96, 16
  DEFPUSHBUTTON   "确定", 1, 180, 8, 60, 18
  PUSHBUTTON      "取消", 2, 180, 30, 60, 18
END

// ---------------------------- 关于 / 开源协议 ----------------------------
// 和 设置、更改文件日期 一样：模板坐标只是占位，AboutProc / LicenseProc 在
// WM_INITDIALOG 里按 DPI 重新量放。文本内容由代码设置（许可证全文太长，不适合
// 写在资源模板里）。
IDD_ABOUT DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于"
FONT 9, "Microsoft YaHei", 0, 0, 1
BEGIN
  ICON            IDI_IC_APP, IDC_ABOUT_ICON, 12, 10, 20, 20
  LTEXT           "Arade文件更名器", IDC_ABOUT_TITLE, 40, 10, 200, 10
  LTEXT           "", IDC_ABOUT_TEXT, 12, 34, 236, 90
  PUSHBUTTON      "赞助/联系(&S)", IDC_ABOUT_SPONSOR, 58, 126, 64, 16
  PUSHBUTTON      "开源协议(&L)", IDC_ABOUT_LICENSE, 128, 126, 60, 16
  DEFPUSHBUTTON   "确定", 1, 192, 126, 56, 16
END

// 收款码 + 联系方式 + 误报免责声明。坐标只是占位，SponsorProc 按 DPI 重新量放；
// 三个二维码和三行链接是普通 Static，但装了子类化过程自绘/响应点击（见 main.cpp SponsorSubProc）；
// 文字都写在本模板里，所以语言包能照常覆盖。
IDD_SPONSOR DIALOGEX 0, 0, 230, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "赞助与支持"
FONT 9, "Microsoft YaHei", 0, 0, 1
BEGIN
  CONTROL "微信",      IDC_SP_QR_WX,  "Static", WS_CHILD | WS_VISIBLE | SS_LEFT | SS_NOTIFY, 8, 8, 52, 68
  CONTROL "支付宝",    IDC_SP_QR_ALI, "Static", WS_CHILD | WS_VISIBLE | SS_LEFT | SS_NOTIFY, 68, 8, 52, 68
  CONTROL "PayPal",    IDC_SP_QR_PP,  "Static", WS_CHILD | WS_VISIBLE | SS_LEFT | SS_NOTIFY, 128, 8, 52, 68
  CONTROL "开源地址: https://github.com/yjhua2005/AradeRenamer/", IDC_SP_GITHUB, "Static", WS_CHILD | WS_VISIBLE | SS_LEFT | SS_NOTIFY, 8, 84, 200, 8
  CONTROL "QQ 群: 484508921", IDC_SP_QQ, "Static", WS_CHILD | WS_VISIBLE | SS_LEFT | SS_NOTIFY, 8, 96, 130, 8
  PUSHBUTTON "复制群号", IDC_SP_COPY_QQ, 160, 94, 48, 12
  CONTROL "开发者: yjhua2005    个人 QQ: 10683223", IDC_SP_AUTHOR, "Static", WS_CHILD | WS_VISIBLE | SS_LEFT, 8, 108, 200, 8
  CONTROL "邮箱: 10683223@qq.com", IDC_SP_EMAIL, "Static", WS_CHILD | WS_VISIBLE | SS_LEFT | SS_NOTIFY, 8, 120, 200, 8
  CONTROL "开源协议: MIT (见仓库根目录 LICENSE 文件)", IDC_SP_LIC, "Static", WS_CHILD | WS_VISIBLE | SS_LEFT, 8, 132, 200, 8
  GROUPBOX "", IDC_SP_DISCLAIMER, 8, 144, 214, 34
  CONTROL "本软件纯 Win32 API 开发，无任何联网/后门行为。若遇到杀毒软件误报，请将本程序加入信任区，或自行从源码编译。", IDC_SP_DISC_TEXT, "Static", WS_CHILD | WS_VISIBLE | SS_LEFT, 14, 152, 202, 22
  DEFPUSHBUTTON "确定", 1, 182, 182, 40, 14
END

IDD_LICENSE DIALOGEX 0, 0, 340, 240
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "开源协议"
FONT 9, "Microsoft YaHei", 0, 0, 1
BEGIN
  ; CONTROL 的样式是原样使用的，WS_CHILD/WS_VISIBLE 要自己写全（和 2735、2806 一样）。
  CONTROL         "", IDC_LIC_TEXT, "Edit", WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_TABSTOP, 8, 8, 324, 200
  DEFPUSHBUTTON   "确定", 1, 276, 216, 56, 16
END

// ----------------------------- Icons -----------------------------
// IDI_IC_APP has the lowest numeric ID, so it becomes the default EXE icon.
IDI_IC_APP    ICON "resources\ICON\ic_app.ico"
IDI_IC_ADD    ICON "resources\ICON\ic_add.ico"
IDI_IC_ADDF   ICON "resources\ICON\ic_folder.ico"
IDI_IC_DEL    ICON "resources\ICON\ic_del.ico"
IDI_IC_CLEAR  ICON "resources\ICON\ic_clear.ico"
IDI_IC_PREVIEW ICON "resources\ICON\ic_preview.ico"
IDI_IC_APPLY  ICON "resources\ICON\ic_apply.ico"
IDI_IC_UNDO   ICON "resources\ICON\ic_undo.ico"
IDI_IC_PIN    ICON "resources\ICON\ic_pin.ico"
IDI_IC_TAGDEL ICON "resources\ICON\ic_tagdel.ico"
IDI_IC_TAGEXT ICON "resources\ICON\ic_tagext.ico"
IDI_IC_TAGWRITE ICON "resources\ICON\ic_tagwrite.ico"
IDI_IC_T2S    ICON "resources\ICON\ic_t2s.ico"
IDI_IC_TEXTCMD ICON "resources\ICON\ic_textcmd.ico"
IDI_IC_EXPLIST ICON "resources\ICON\ic_explist.ico"
IDI_IC_RECOPEN ICON "resources\ICON\ic_recopen.ico"
IDI_IC_RECSAVE ICON "resources\ICON\ic_recsave.ico"
IDI_IC_RECCLEAR ICON "resources\ICON\ic_recclear.ico"
IDI_IC_CHGDATE ICON "resources\ICON\ic_chgdate.ico"
IDI_IC_RECPANEL ICON "resources\ICON\ic_recpanel.ico"
IDI_IC_SPONSOR  ICON "resources\ICON\ic_sponsor.ico"

// --------------------------- 开源许可证全文 ---------------------------
// 上游 LICENSE 原文，未作修改，编译时打进 exe；"关于 -- 开源协议" 直接读 RCDATA。
IDR_LIC_OPENCC   RCDATA "data\license_opencc.txt"
IDR_LIC_PINYIN   RCDATA "data\license_pinyin_data.txt"

// ----------------------------- 赞助收款码 -----------------------------
// 由 tools\prep_sponsor.cmd 从 REF\ 生成（已 -strip 去元数据、限 720px、统一压缩），
// 打进 exe 后磁盘上不留散落的图片文件。换图 = 覆盖 REF\ 源图 -> 跑脚本 -> 重新编译。
IDR_SPONSOR_WECHAT RCDATA "resources/sponsor_wechat.jpg"
IDR_SPONSOR_ALIPAY RCDATA "resources/sponsor_alipay.jpg"
IDR_SPONSOR_PAYPAL RCDATA "resources/sponsor_paypal.jpg"

// ----------------------------- 数据字典 ------------------------------
// 全部是上游原文件，一个字节都没改：升级字典只要覆盖这几个文件重新编译，
// 不需要同步脚本、也不需要在用户机器上带数据文件。
//   TSCharacters.txt 键=繁体 值=简体 (OpenCC 的 t2s 用)
//   STCharacters.txt 键=简体 值=繁体 (OpenCC 的 s2t 用)
//   TSPhrases.txt / STPhrases.txt 是对应的词组表 (最长匹配, 优先于单字)
// 注意: Add-ons\gbkfix.txt 故意不在这里 —— 它是运行时从磁盘读的用户自定义
// 修正表，改了不用重新编译。
IDR_DICT_T2S     RCDATA "data\\dictionary\\TSCharacters.txt"
IDR_DICT_S2T     RCDATA "data\\dictionary\\STCharacters.txt"
IDR_PINYIN       RCDATA "data\pinyin.txt"
IDR_DICT_T2S_PHRASES RCDATA "data\\dictionary\\TSPhrases.txt"
IDR_DICT_S2T_PHRASES RCDATA "data\\dictionary\\STPhrases.txt"
// 内置语言包: 没有 Language\ 目录时靠这两个也能用中文/英文; 磁盘上的同名语言
// (按 lang.code 匹配) 会覆盖内嵌副本, 所以加语言不必重新编译。
IDR_LANG_ZH_CN       RCDATA "Language\\lang_zh-CN.ini"
IDR_LANG_EN_US       RCDATA "Language\\lang_en-US.ini"

// ----------------------------- 版本信息 ------------------------------
// exe 属性里的「版本」标签页全靠这一段；没有它属性会显示 0.0.0.0，
// 也拿不到产品名和版权（v1.0 发布必须有）。沿用本文件自包含的风格，
// 不 #include <winver.h>，常量自己定义。
#define VOS_NT_WINDOWS32   0x00040004L
#define VFT_APP            0x00000001L
#define VFT2_UNKNOWN       0x00000000L

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "yjhua2005"
            VALUE "FileDescription",  "AradeRenamer - Batch file renamer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AradeRenamer"
            VALUE "LegalCopyright",   "Copyright (c) 2026 yjhua2005"
