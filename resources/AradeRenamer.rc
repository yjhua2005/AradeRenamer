// ----------------------------- Menu -----------------------------
// 条目、顺序、分割线、快捷键全部按 指令.txt 的第一段。文档里的"保持操作记录(S)"按工具栏
// 同名条目写成"保存操作记录"; "ID3v2复制到ID3v1(3)"的助记符取 (V)。
IDR_MAINMENU MENU
BEGIN
  POPUP "文件(&F)"
  BEGIN
    MENUITEM "添加文件(&A)\tCtrl+Shift+A",  4001
    MENUITEM "导出当前列表(&E)\tCtrl+Shift+L", 4004
    MENUITEM "退出(&X)\tAlt+F4",            4003
  END
  POPUP "更名(&P)"
  BEGIN
    MENUITEM "预览(&P)\tCtrl+F",            4011
    MENUITEM "应用(&A)\tCtrl+E",            4012
    MENUITEM SEPARATOR
    MENUITEM "撤销(&U)\tCtrl+Z",            4013
    MENUITEM SEPARATOR
    MENUITEM "打开操作记录(&O)\tCtrl+O",     4100
    MENUITEM "保存操作记录(&S)\tCtrl+S",     4101
    MENUITEM "清除操作记录(&C)\tCtrl+Shift+R", 4102
    MENUITEM SEPARATOR
    MENUITEM "调用文本文件命名(&T)\tCtrl+Shift+T", 4103
    MENUITEM "提取音乐文件标签命名(&I)\tCtrl+D", 4104
    MENUITEM SEPARATOR
    MENUITEM "文件名繁体转简体(&G)\tCtrl+Alt+S", 4105
    MENUITEM "文件名简体转繁体(&X)\tCtrl+Alt+T", 4106
    MENUITEM "文件名 BIG5 -> GB(&5)\tCtrl+G",    4107
    MENUITEM "文件名 GB -> BIG5(&W)\tCtrl+Alt+B", 4108
    MENUITEM "文件名日文Shift-JIS转中文(&J)\tCtrl+Alt+G",  4109
    MENUITEM "文件名中文转日文Shift-JIS(&B)\tCtrl+Alt+J",  4110
    MENUITEM SEPARATOR
    MENUITEM "以文件的 CRC32 更名(&R)\tCtrl+Alt+C",        4111
    MENUITEM "以网页文件的标题更名(&Y)\tCtrl+T",            4112
    MENUITEM "以文本文件的第一行内容更名(&Z)\tCtrl+L",       4113
  END
  POPUP "标签(&T)"
  BEGIN
    MENUITEM "移除音乐文件标签(&M)\tCtrl+R",  4120
    MENUITEM "写入音乐文件标签(&W)\tCtrl+W",  4121
    MENUITEM SEPARATOR
    MENUITEM "导出音乐文件标签(&R)\tCtrl+Shift+E", 4122
    MENUITEM "利用文本文件写入标签(&B)\tCtrl+Shift+I", 4123
    MENUITEM SEPARATOR
    MENUITEM "MP3文件的ID3v1复制到ID3v2(&P)", 4124
    MENUITEM "MP3文件的ID3v2复制到ID3v1(&V)", 4125
    MENUITEM SEPARATOR
    MENUITEM "音乐文件标签 BIG5 -> GB(&E)",   4126
    MENUITEM "音乐文件标签 GB -> BIG5(&F)",   4127
    MENUITEM "音乐文件标签繁体转简体(&Y)",      4128
    MENUITEM "音乐文件标签简体转繁体(&Z)",      4129
    MENUITEM "音乐文件标签日文Shift-JIS转中文(&S)", 4130
    MENUITEM "音乐文件标签中文转日文Shift-JIS(&H)", 4131
  END
  POPUP "选项(&O)"
  BEGIN
    MENUITEM "设置(&O)\tCtrl+Shift+O",        4022
    MENUITEM "窗口居中显示(&Y)",              4140
    POPUP "语言(&L)"
    BEGIN
      MENUITEM "（无）",                      4141, GRAYED
    END
    MENUITEM SEPARATOR
    // 这两项写的是 HKEY_CLASSES_ROOT(对所有用户生效), 需要管理员权限 ——
    // 名字里带上「管理员」, 免得用户以为点了没动静。助记符: 卸载 Z / 添加 A。
    MENUITEM "卸载右键菜单(管理员)(&Z)",      4142
    MENUITEM "添加右键菜单(管理员)(&A)",      4143
    MENUITEM SEPARATOR
    MENUITEM "从 发送到 菜单移除(&V)",          4146
    MENUITEM "添加到 发送到 菜单(&S)",          4145
  END
  POPUP "帮助(&H)"
  BEGIN
    MENUITEM "用户手册(&H)\tF1",              4144
    MENUITEM SEPARATOR
    MENUITEM "关于...(&A)",                   4099
  END
END

// ----------------------------- Accelerators -----------------------------
// 后半段是后来补的、菜单里原本没标快捷键的那几条 (见菜单里的 \tCtrl+Shift+X)。
// 一律用 Ctrl+Shift+<字母>: Ctrl+<字母> 那一批已经排满了, 而且 Ctrl+A / Ctrl+Z
// 在输入框里是编辑键, 加 Shift 就不跟它们抢 (消息循环里还有一道焦点保护)。
// 文件列表的 Delete 键不在这里——它挂的是列表自己的 LVN_KEYDOWN, 这样焦点在
// 输入框里时列表收不到通知, Delete 仍然是"删字符", 不会误删列表行。
IDR_MAINACC ACCELERATORS
BEGIN
    "F",            4011, VIRTKEY, CONTROL
    "E",            4012, VIRTKEY, CONTROL
    "Z",            4013, VIRTKEY, CONTROL
    "O",            4100, VIRTKEY, CONTROL
    "S",            4101, VIRTKEY, CONTROL
    "D",            4104, VIRTKEY, CONTROL
    "G",            4107, VIRTKEY, CONTROL
    "T",            4112, VIRTKEY, CONTROL
    "L",            4113, VIRTKEY, CONTROL
    "R",            4120, VIRTKEY, CONTROL
    "W",            4121, VIRTKEY, CONTROL
    "S",            4105, VIRTKEY, CONTROL, ALT
    "T",            4106, VIRTKEY, CONTROL, ALT
    "B",            4108, VIRTKEY, CONTROL, ALT
    "G",            4109, VIRTKEY, CONTROL, ALT
    "J",            4110, VIRTKEY, CONTROL, ALT
    "C",            4111, VIRTKEY, CONTROL, ALT
    "A",            4205, VIRTKEY, CONTROL
    VK_F1,          4144, VIRTKEY
    "A",            4001, VIRTKEY, CONTROL, SHIFT
    "L",            4004, VIRTKEY, CONTROL, SHIFT
    "R",            4102, VIRTKEY, CONTROL, SHIFT
    "T",            4103, VIRTKEY, CONTROL, SHIFT
    "E",            4122, VIRTKEY, CONTROL, SHIFT
    "I",            4123, VIRTKEY, CONTROL, SHIFT
    "O",            4022, VIRTKEY, CONTROL, SHIFT
END

// ----------------------------- Dialog ---------------------------
// NOTE: control positions below are placeholders. Every control is re-placed
// in pixels (DPI-scaled) by Layout() in main.cpp, so the dialog looks the same
// on any font/DPI setting. Only the control set, IDs and styles are authoritative here.
//
// Styles are literal hex and all carry WS_CLIPSIBLINGS (0x04000000).
// Template order IS the sibling z-order, verified against the live dialog with
// GetWindow(GW_CHILD)/GW_HWNDNEXT: the control listed FIRST is TOPMOST. So every
// container (each group box, the SysTabControl32) is listed AFTER the controls it
// holds; otherwise the container paints its background over them and, because they
// are clipped siblings, they never repaint and look invisible.
IDR_MAINDLG DIALOGEX 0, 0, 700, 160
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "Arade文件更名器"
MENU IDR_MAINMENU
FONT 9, "Microsoft YaHei", 0, 0, 1
BEGIN
  // ---- Toolbar (owner-draw icon buttons; order/spacing/separators set in Layout()) ----
  // 类命令, 这两项将移到列表右键菜单里。
  CONTROL         "", 1101, "Button", 0x5401000B, 2,  1,  24, 24   // 添加文件
  CONTROL         "", 1102, "Button", 0x5401000B, 9,  1,  24, 24   // 添加目录
  CONTROL         "", 1107, "Button", 0x5401000B, 31, 1,  24, 24   // 预览
  CONTROL         "", 1105, "Button", 0x5401000B, 46, 1,  24, 24   // 撤销
  CONTROL         "", 1104, "Button", 0x5401000B, 38, 1,  24, 24   // 应用
  CONTROL         "", 1109, "Button", 0x5401000B, 54, 1,  24, 24   // 移除音乐文件标签
  CONTROL         "", 1110, "Button", 0x5401000B, 61, 1,  24, 24   // 提取音乐文件标签命名
  CONTROL         "", 1111, "Button", 0x5401000B, 68, 1,  24, 24   // 写入音乐文件标签
  CONTROL         "", 1112, "Button", 0x5401000B, 75, 1,  24, 24   // 文件名繁体转简体
  CONTROL         "", 1113, "Button", 0x5401000B, 82, 1,  24, 24   // 调用文本文件命令
  CONTROL         "", 1114, "Button", 0x5401000B, 89, 1,  24, 24   // 导出当前文件列表
  CONTROL         "", 1115, "Button", 0x5401000B, 96, 1,  24, 24   // 打开操作记录
  CONTROL         "", 1116, "Button", 0x5401000B, 103, 1, 24, 24   // 保存操作记录
  CONTROL         "", 1117, "Button", 0x5401000B, 110, 1, 24, 24   // 清除操作记录
  CONTROL         "", 1118, "Button", 0x5401000B, 117, 1, 24, 24   // 更改文件日期
  CONTROL         "", 1119, "Button", 0x5401000B, 124, 1, 24, 24   // 显示操作记录面板
  CONTROL         "", 1108, "Button", 0x5401000B, 131, 1, 24, 24   // 窗口置顶
  CONTROL         "", 1120, "Button", 0x5401000B, 138, 1, 24, 24   // 赞助 / 联系 (Layout 里钉在最右边)

  // =================== Tab 0: 整体 ===================
  CONTROL         "文件名改成大写", 2001, "Button", 0x54020009, 5,  16, 100, 14
  CONTROL         "文件名改成小写", 2002, "Button", 0x54010009, 20, 16, 100, 14
  CONTROL         "文件名中单词第一个字母大写", 2003, "Button", 0x54010009, 34, 16, 170, 14
  LTEXT           "文件名改成", 2011, 62, 17, 60, 14
  EDITTEXT        2004, 78, 16, 150, 16, 0x54810080
  CONTROL         "扩展名改成大写", 2005, "Button", 0x54020009, 5,  52, 100, 14
  CONTROL         "扩展名改成小写", 2006, "Button", 0x54010009, 20, 52, 100, 14
  LTEXT           "扩展名改成", 2012, 34, 53, 60, 14
  EDITTEXT        2007, 50, 52, 120, 16, 0x54810080
  LTEXT           "文件过滤", 2013, 62, 53, 50, 14
  CONTROL         "", 2008, "ComboBox", 0x54110002, 78, 52, 144, 120   // CBS_DROPDOWN: 预设可挑, 也能手工输入
  CONTROL         "文件名", 2009, "Button", 0x54000007, 3,  11, 688, 34
  CONTROL         "扩展名", 2010, "Button", 0x54000007, 3,  47, 688, 34

  // =================== Tab 1: 替换 ===================
  CONTROL         "启用替换", 2101, "Button", 0x54020003, 5,  16, 70, 14
  LTEXT           "查找", 2107, 15, 17, 30, 14
  EDITTEXT        2102, 22, 16, 150, 16, 0x54810080
  LTEXT           "替换为", 2108, 42, 17, 40, 14
  EDITTEXT        2103, 53, 16, 150, 16, 0x54810080
  CONTROL         "正则表达式(查找以 : 开头)", 2104, "Button", 0x54010003, 79, 16, 150, 14
  CONTROL         "忽略大小写", 2105, "Button", 0x54010003, 104, 16, 80, 14
  CONTROL         "替换", 2106, "Button", 0x54000007, 3, 11, 688, 34

  // =================== Tab 2: 序号 ===================
  CONTROL         "启用序号", 2201, "Button", 0x54020003, 5,  16, 70, 14
