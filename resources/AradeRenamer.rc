  LTEXT           "文件名表达式", 2621, 5, 22, 74, 14
  EDITTEXT        2622, 20, 21, 220, 16, 0x54810080
  LTEXT           "预设", 2623, 60, 22, 34, 14
  CONTROL         "", 2624, "ComboBox", 0x54110003, 66, 21, 120, 120   // CBS_DROPDOWNLIST
  PUSHBUTTON      "清空", 2625, 100, 21, 50, 16
  LTEXT           "艺术家", 2630, 5, 33, 44, 14
  EDITTEXT        2631, 15, 32, 140, 16, 0x54810080
  LTEXT           "标题", 2632, 40, 33, 34, 14
  EDITTEXT        2633, 50, 32, 140, 16, 0x54810080
  LTEXT           "专辑", 2634, 75, 33, 34, 14
  EDITTEXT        2635, 85, 32, 140, 16, 0x54810080
  PUSHBUTTON      "保存", 2626, 100, 32, 50, 16
  LTEXT           "音轨", 2636, 5, 44, 34, 14
  EDITTEXT        2637, 12, 43, 44, 16, 0x54810080
  LTEXT           "年代", 2638, 25, 44, 34, 14
  EDITTEXT        2639, 32, 43, 52, 16, 0x54810080
  LTEXT           "流派", 2640, 45, 44, 34, 14
  CONTROL         "", 2641, "ComboBox", 0x54110002, 52, 43, 120, 120   // CBS_DROPDOWN: 可挑可输
  LTEXT           "注释", 2642, 70, 44, 34, 14
  EDITTEXT        2643, 80, 43, 164, 16, 0x54810080
  PUSHBUTTON      "全写", 2627, 100, 43, 50, 16

  // ---- Tab control: behind every tab-page control, so it must come last ----
  CONTROL         "", 1200, "SysTabControl32", 0x54010000, 2, 7, 690, 90

  // ---- ListView (columns added in code) ----
  // 0x...0001 = LVS_REPORT only. Bit 0x400 here would be LVS_OWNERDRAWFIXED, which
  // makes the control expect WM_DRAWITEM per row and leaves every row blank.
  CONTROL         "", 1201, "SysListView32", 0x54810001, 2, 99, 690, 55
END

// ----------------------------- Settings dialog -----------------------------
// The template geometry below is a placeholder: like the main dialog, SettingsProc
// re-sizes and re-places every control in DPI-scaled pixels (the DLU grid depends on
// the mapped font, which made the controls land outside the client area).
// Geometry below is a placeholder grid (roughly 1 DLU = 2 base pixels). SettingsProc
// re-creates the size and re-places every control in DPI-scaled pixels, so only the
// control set, the IDs and the styles are load-bearing here.
IDD_SETTINGS DIALOGEX 0, 0, 180, 115
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "Microsoft YaHei", 0, 0, 1
BEGIN
  // =================== Page 0: 一般参数 ===================
  CONTROL         "忽略文件夹", 2711, "Button", 0x54020003, 8, 17, 75, 8
  CONTROL         "文件列表在初始化时排序", 2715, "Button", 0x54020003, 90, 17, 82, 8
  CONTROL         "遍历文件夹下的所有文件", 2712, "Button", 0x54020003, 8, 28, 80, 8
  CONTROL         "快速自动预览（只预览前十项）", 2716, "Button", 0x54020003, 90, 28, 84, 8
  CONTROL         "不获取文件的日期", 2713, "Button", 0x54020003, 8, 39, 75, 8
  CONTROL         "自动更正错误", 2717, "Button", 0x54020003, 90, 39, 75, 8
  CONTROL         "文件更名自动预览", 2714, "Button", 0x54020003, 8, 50, 75, 8
  CONTROL         "退出时确认", 2718, "Button", 0x54020003, 90, 50, 75, 8
  LTEXT           "文件名单词判断字符", 2719, 8, 66, 55, 7
  CONTROL         "", 2720, "ComboBox", 0x54110003, 75, 64, 60, 60   // CBS_DROPDOWNLIST

  // =================== Page 1: 音乐文件标签 ===================
  CONTROL         "MP3 ID3v2 标签优先", 2721, "Button", 0x54020003, 8, 17, 75, 8
  LTEXT           "* 默认为ID3v1优先", 2722, 100, 18, 70, 7
  LTEXT           "移除ID3标签时", 2723, 8, 31, 45, 7
  CONTROL         "", 2724, "ComboBox", 0x54110003, 55, 30, 70, 60
  LTEXT           "ID3标签写入时", 2725, 8, 44, 45, 7
  CONTROL         "", 2726, "ComboBox", 0x54110003, 55, 43, 70, 60
  CONTROL         "标签写入时提示", 2727, "Button", 0x54020003, 8, 57, 70, 8
  CONTROL         "保留文件日期", 2728, "Button", 0x54020003, 100, 57, 70, 8
  CONTROL         "音轨数字低于两位自动补0", 2729, "Button", 0x54020003, 8, 68, 85, 8
  CONTROL         "保留空白项的标签", 2730, "Button", 0x54020003, 8, 79, 70, 8
  CONTROL         "写入前先备份原文件 (.bak)", 2701, "Button", 0x54020003, 100, 79, 82, 8

  // =================== Page 2: 导出文件列表 ===================
  CONTROL         "同时导出文件扩展名", 2731, "Button", 0x54020003, 8, 17, 80, 8
  CONTROL         "同时导出文件路径", 2732, "Button", 0x54020003, 8, 28, 80, 8
  CONTROL         "不包括文件夹", 2733, "Button", 0x54020003, 8, 39, 80, 8

  // =================== Page 3: 元变量 ===================
  CONTROL         "使用元变量", 2734, "Button", 0x54020003, 8, 16, 60, 8
  CONTROL         "", 2735, "SysListView32", 0x54810001, 8, 27, 156, 62   // LVS_REPORT

  // =================== Page 4: 界面 ===================
  CONTROL         "文件列表使用增强界面", 2736, "Button", 0x54020003, 8, 17, 85, 8
