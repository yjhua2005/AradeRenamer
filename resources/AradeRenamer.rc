  CONTROL         "启用扩展更名", 2501, "Button", 0x54020003, 5,  16, 90, 14
  CONTROL         "添加扩展名", 2502, "Button", 0x54020009, 29, 16, 80, 14
  CONTROL         "删除扩展名", 2503, "Button", 0x54010009, 49, 16, 80, 14
